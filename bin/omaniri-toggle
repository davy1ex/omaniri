#!/bin/bash
# Turn Omaniri' Hyprland config on or off and reload Hyprland.
#
#   omaniri-toggle [extras] [on|off|toggle|status|refresh]
#
# The lua source lives next to this script, inside the plugin directory, so
# installing the plugin is the whole install -- nothing is copied into
# ~/.config/hypr first. Turning it on copies the source into
# ~/.local/state/omarchy/toggles/hypr/omaniri.lua, the directory Omarchy's
# default toggle loader sources on every reload; turning it off removes it.

set -euo pipefail

usage() {
  echo "Usage: omaniri-toggle [extras] [on|off|toggle|status|refresh]" >&2
}

NAME="${1:-extras}"
ACTION="${2:-toggle}"

# BASH_SOURCE rather than $0: this is also run as `bash <path>/omaniri-toggle`
# from a plugin directory that may have lost its executable bits.
PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
TOGGLES_DIR="$STATE_HOME/omarchy/toggles/hypr"
FLAG_FILE="$TOGGLES_DIR/omaniri.lua"
SOURCE="$PLUGIN_DIR/hypr/omaniri.lua"

case "$NAME" in
  extras) ;;
  *)
    echo "Unknown Omaniri target: $NAME" >&2
    usage
    exit 1
    ;;
esac

# Copy into place via a temp file in the destination directory and rename, so a
# reload racing the copy never sources a half-written lua file.
on() {
  [[ -f $SOURCE ]] || { echo "Missing $SOURCE -- the plugin install is incomplete." >&2; exit 1; }
  mkdir -p "$TOGGLES_DIR"
  local tmp
  tmp="$(mktemp "$TOGGLES_DIR/.omaniri.XXXXXX")"
  cp "$SOURCE" "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$FLAG_FILE"
}

off() {
  rm -f "$FLAG_FILE"
}

case "$ACTION" in
  status)
    [[ -f $FLAG_FILE ]] && echo "on" || echo "off"
    exit 0
    ;;
  refresh)
    if [[ -f $FLAG_FILE ]]; then
      on
      echo "on"
    else
      echo "off"
    fi
    exit 0
    ;;
  toggle)
    if [[ -f $FLAG_FILE ]]; then ACTION=off; else ACTION=on; fi
    ;;
  on | off) ;;
  *)
    usage
    exit 1
    ;;
esac

if [[ $ACTION == on ]]; then
  on
else
  off
fi

# A reload applies the change. Hyprland not running is not a toggle failure:
# the flag file is already correct and the next reload picks it up.
hyprctl reload >/dev/null 2>&1 || echo "Config written, but 'hyprctl reload' failed." >&2

[[ -f $FLAG_FILE ]] && echo "on" || echo "off"
